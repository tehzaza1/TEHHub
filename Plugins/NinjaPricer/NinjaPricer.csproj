<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>1701;1702;1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TEHhub\TEHhub.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyFiles" AfterTargets="Build">
    <ItemGroup>
      <_NinjaPricerDeployFiles Include="$(OutDir)$(TargetName)$(TargetExt)" />
      <_NinjaPricerDeployFiles Include="$(OutDir)$(TargetName).pdb" Condition="Exists('$(OutDir)$(TargetName).pdb')" />
      <_NinjaPricerDeployFiles Include="$(MSBuildProjectDirectory)\expedition2_recipes.json" Condition="Exists('$(MSBuildProjectDirectory)\expedition2_recipes.json')" />
      <_NinjaPricerDeployFiles Include="$(MSBuildProjectDirectory)\uniqueArtMapping.json" Condition="Exists('$(MSBuildProjectDirectory)\uniqueArtMapping.json')" />
      <_NinjaPricerDeployFiles Include="$(MSBuildProjectDirectory)\pathBasenameToItemName.json" Condition="Exists('$(MSBuildProjectDirectory)\pathBasenameToItemName.json')" />
      <_NinjaPricerDeployFiles Include="$(MSBuildProjectDirectory)\default.wav" Condition="Exists('$(MSBuildProjectDirectory)\default.wav')" />
      <_NinjaPricerResourceFiles Include="$(MSBuildProjectDirectory)\resources\**\*.*" />
      <_NinjaPricerLocalizationFiles Include="$(MSBuildProjectDirectory)\Localization\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_NinjaPricerDeployFiles)"
          DestinationFolder="..\..\TEHhub\$(OutDir)Plugins\$(ProjectName)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_NinjaPricerResourceFiles)"
          DestinationFiles="@(_NinjaPricerResourceFiles->'..\..\TEHhub\$(OutDir)Plugins\$(ProjectName)\resources\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_NinjaPricerLocalizationFiles)"
          DestinationFolder="..\..\TEHhub\$(OutDir)Plugins\$(ProjectName)\Localization"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
