<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>1701;1702;1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebServer\wwwroot\index.html">
      <LogicalName>webui.index.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="WebServer\wwwroot\style.css">
      <LogicalName>webui.style.css</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="WebServer\wwwroot\settings.js">
      <LogicalName>webui.settings.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TEHhub\TEHhub.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyFiles" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)$(TargetName)$(TargetExt);$(OutDir)$(TargetName).pdb;$(OutDir)$(TargetName).deps.json;"
          DestinationFolder="..\..\TEHhub\$(OutDir)Plugins\$(ProjectName)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
    <ItemGroup>
      <_AutoExile2SqliteDependency Include="$(OutDir)Microsoft.Data.Sqlite.dll" Condition="Exists('$(OutDir)Microsoft.Data.Sqlite.dll')" />
      <_AutoExile2SqliteDependency Include="$(OutDir)SQLitePCLRaw.batteries_v2.dll" Condition="Exists('$(OutDir)SQLitePCLRaw.batteries_v2.dll')" />
      <_AutoExile2SqliteDependency Include="$(OutDir)SQLitePCLRaw.core.dll" Condition="Exists('$(OutDir)SQLitePCLRaw.core.dll')" />
      <_AutoExile2SqliteDependency Include="$(OutDir)SQLitePCLRaw.provider.e_sqlite3.dll" Condition="Exists('$(OutDir)SQLitePCLRaw.provider.e_sqlite3.dll')" />
      <_AutoExile2NativeDependency Include="$(OutDir)e_sqlite3.dll" Condition="Exists('$(OutDir)e_sqlite3.dll')" />
    </ItemGroup>
    <Copy SourceFiles="$(OutDir)Nefarius.ViGEm.Client.dll"
          DestinationFolder="..\..\TEHhub\$(OutDir)Plugins\$(ProjectName)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
    <MakeDir Directories="..\..\TEHhub\$(OutDir)Plugins\$(ProjectName)\Dependencies" />
    <Copy SourceFiles="@(_AutoExile2SqliteDependency)"
          DestinationFolder="..\..\TEHhub\$(OutDir)Plugins\$(ProjectName)\Dependencies"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
    <MakeDir Directories="..\..\TEHhub\$(OutDir)Plugins\$(ProjectName)\runtimes\win-x64\native" />
    <Copy SourceFiles="@(_AutoExile2NativeDependency)"
          DestinationFiles="@(_AutoExile2NativeDependency->'..\..\TEHhub\$(OutDir)Plugins\$(ProjectName)\runtimes\win-x64\native\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
    <ItemGroup>
      <WebFiles Include="WebServer\wwwroot\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebFiles)"
          DestinationFolder="..\..\TEHhub\$(OutDir)Plugins\$(ProjectName)\WebServer\wwwroot"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
  </Target>

</Project>
