<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <NoWarn>1701;1702; 1591</NoWarn>
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TEHhub\TEHhub.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyFiles" AfterTargets="Build">
    <ItemGroup>
      <_ExpeditionPathOptimizerDeployFiles Include="$(OutDir)$(TargetName)$(TargetExt)" />
      <_ExpeditionPathOptimizerDeployFiles Include="$(OutDir)$(TargetName).pdb" Condition="Exists('$(OutDir)$(TargetName).pdb')" />
      <_ExpeditionPathOptimizerDeployFiles Include="$(MSBuildProjectDirectory)\expedition2_recipes.json" Condition="Exists('$(MSBuildProjectDirectory)\expedition2_recipes.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(_ExpeditionPathOptimizerDeployFiles)"
          DestinationFolder="..\..\TEHhub\$(OutDir)Plugins\$(ProjectName)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
